# ─── Supabase ──────────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable / anon). É usada apenas no servidor por este app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (secret / service_role). NUNCA exponha no navegador.
SUPABASE_SECRET_KEY=

# ─── Criptografia dos segredos salvos pela tela de Configurações ─────────────
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Endereço público do sistema (usado para checar a origem das requisições)
APP_URL=https://cobranca.iegcolegioecurso.com.br

# ─── WhatsApp (Meta WhatsApp Cloud API) — opcional ──────────────────────────
# Podem ser configurados aqui OU pela tela Configurações → WhatsApp.
# O que for salvo pela tela tem prioridade sobre estas variáveis.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Usados pelo webhook de status de entrega (/api/webhooks/whatsapp)
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# ─── E-mail — opcional (pode ser configurado pela tela também) ──────────────
# SMTP (serve para Gmail/Google Workspace com senha de app, Outlook, Hostinger etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# E-mail remetente (precisa ser autorizado pelo provedor)
EMAIL_FROM_ADDRESS=
# Resend (alternativa ao SMTP)
RESEND_API_KEY=
